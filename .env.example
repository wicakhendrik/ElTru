# Salin ke .env lalu ganti nilainya:  cp .env.example .env
# Generate password acak:             openssl rand -hex 16

DB_NAME=elearning
DB_USER=eltru
DB_PASS=ganti_dengan_password_acak
DB_ROOT_PASS=ganti_dengan_password_root_acak

# Port aplikasi di host.
# APP_BIND=127.0.0.1 -> hanya bisa diakses dari server itu sendiri (aman, pakai reverse proxy)
# APP_BIND=0.0.0.0   -> terbuka ke jaringan (hanya untuk testing)
APP_BIND=127.0.0.1
APP_PORT=8088
